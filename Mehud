-- 3. หายตัว / ล่องหน (Transparency Invisibility)
AddToggle(PageGod, "หายตัว / ล่องหน", "Invisibility", false, function(val)
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
